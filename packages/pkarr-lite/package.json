{
  "name": "@paltaio/pkarr-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./dns": "./src/dns.ts",
    "./keys": "./src/keys.ts"
  },
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:type-aware": "oxlint --type-aware .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "5.9.3"
  }
}
